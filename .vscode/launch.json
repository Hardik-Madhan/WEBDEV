{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "1. Launch Backend (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js",
      "runtimeArgs": ["--inspect=9229"],
      "restart": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "2. Launch Frontend (Chrome)",
      "url": "http://localhost:3000/login.html",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "3. Attach to Backend (port 9229)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full-Stack Debug (Frontend + Backend)",
      "configurations": [
        "1. Launch Backend (Node.js)",
        "2. Launch Frontend (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
